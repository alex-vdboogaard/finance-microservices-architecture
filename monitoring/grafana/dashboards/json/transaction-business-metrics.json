      "id": 9,
      "title": "Transaction & Business Execution Logs (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{compose_service=~\"transaction-service|account-service|audit-log-service|notification-service\"}",
          "refId": "A"
        }
      ]
